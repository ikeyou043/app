<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>メモアプリ</title>
  </head>
  <body>
    <h1>タイトル : <%= @memo[:title] %> </h1>
    <p><%= @memo[:info] %></p>
    <hr>
    <ul class = "no-dot-list">
      <li><strong>タグ：</strong> <%= @memo[:tag] %></li>
      <li><strong>作成日時：</strong> <%= @memo[:created_at] %></li>
    </ul>
    <div class="action-menu">
      <a href="/" class="btn">戻る</a>
    </div>
  </body>
</html>
